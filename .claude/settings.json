{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/claude-rebuild-on-edit.sh",
            "async": true,
            "statusMessage": "Rebuilding affected package..."
          }
        ]
      }
    ]
  }
}
