{
  "name": "@brainstorm/mcp-server",
  "version": "0.0.1",
  "private": true,
  "description": "Dev MCP server for Brainstorm — exposes plan / OQ / status / coverage / size / i18n / keyboard checks as MCP resources + tools. Loaded via ~/.claude/mcp.json on contributor machines. Not part of the shipped product.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "brainstorm-mcp": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/index.js"
  },
  "dependencies": {
    "@brainstorm/editor": "workspace:*",
    "@brainstorm/sdk-types": "workspace:*",
    "@lexical/headless": "^0.21.0",
    "@lexical/table": "^0.21.0",
    "@lexical/yjs": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "lexical": "^0.21.0",
    "yjs": "^13.6.30",
    "zod": "^3.25.0"
  }
}
